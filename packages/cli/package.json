{
  "name": "@agentis-labs/cli",
  "version": "2.0.0",
  "description": "Agentis owner CLI and local daemon",
  "type": "module",
  "bin": {
    "agentis": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && esbuild src/fixture-daemon.ts --bundle --platform=node --format=esm --outfile=dist/fixture-daemon.mjs && vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src test web vite.config.ts",
    "test": "vitest run",
    "pack:smoke": "node ../../scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@types/node": "24.13.3",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "oxlint": "1.81.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
