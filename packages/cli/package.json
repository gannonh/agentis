{
  "name": "@agentis-labs/cli",
  "version": "2.0.0",
  "description": "Agentis owner CLI and local daemon",
  "type": "module",
  "bin": {
    "agentis": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "test": "vitest run",
    "pack:smoke": "node ../../scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@effect/cluster": "0.60.2",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@effect/rpc": "0.76.2",
    "@effect/sql": "0.52.1",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
