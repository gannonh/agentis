 [\"stop-all: one run was active with completedAt null before\", activeBeforeStop.length === 1 && activeBeforeStop[0].completedAt === null], [\"stop-all: that run is canceled with numeric completedAt after\", afterStop.runs.filter((run) => run.id === activeBeforeStop[0].id).every((run) => run.status === \"canceled\" && typeof run.completedAt === \"number\")], [\"stop-all: every owning task carries updatedAt equal to its run completedAt\", afterStop.tasks.every((task) => afterStop.runs.some((run) => run.taskId === task.id && run.completedAt === task.updatedAt))], [\"stop-all: exactly one stop-all message for the newly canceled run\", afterStop.messages.filter((m) => m.body === \"Stop all canceled this run.\").length === 1], [\"stop-all: SSE stream carries the aggregate stop_all reason\", reasons.includes(\"stop_all\")], [\"stop-all: already-terminal runs are not re-canceled (completedAt unchanged)\", afterStop.runs.find((run) => run.id === canceledRunId).completedAt === canceled(afterCancel).completedAt]]; const result = { issue: \"KAT-3393\", checked_at: new Date().toISOString(), public_surface: \"GET /v1/status and GET /v1/events after agentis run cancel and agentis stop-all\", checks: checks.map(([name, pass]) => ({ name, pass })), verdict: checks.every(([, pass]) => pass) ? \"PASS\" : \"FAIL\" }; writeFileSync(`${dir}/responses/assertions.json`, `${JSON.stringify(result, null, 2)}\\n`); console.log(JSON.stringify(result, null, 2)); if (result.verdict !== \"PASS\") process.exitCode = 1;"
